---
import OrbitScene from "./OrbitScene.astro";
import MatrixWaves from "./MatrixWaves.astro";
import { getCollection } from "astro:content";
const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const post = posts[0];
// Cloudflare branch previews do not fetch private manuscripts. They may link to the
// already public articles so this card remains reviewable without copying that content.
const isBranchPreview = process.env.CF_PAGES === "1" &&
  Boolean(process.env.CF_PAGES_BRANCH) && process.env.CF_PAGES_BRANCH !== "main";
const systemsNotes = [
  { slug: "endianness", previewTitle: "Endianness: From Memory Bytes to Device Boundaries",
    summary: "Why byte order changes at device and protocol boundaries." },
  { slug: "s390-linux-kernel", previewTitle: "The s390x Linux Kernel: From IPL to I/O",
    summary: "Follow Linux on IBM Z from boot to channel I/O and PCIe." },
].flatMap(({ slug, previewTitle, summary }) => {
  const article = posts.find((entry) => entry.slug === slug);
  const path = `/blog/${slug}/`;
  if (article) return [{ href: path, title: article.data.title, summary }];
  if (isBranchPreview) return [{ href: `https://patrykopilka.me${path}`, title: previewTitle, summary }];
  return [];
});
// Thin, stationary echoes carry the field into the exit rail; no runtime animation.
const tailTraces = Array.from({ length: 101 }, (_, index) => {
  const x = index * 13 - 10;
  const sway = Math.round(11 * Math.sin(index * 0.17) + 5 * Math.cos(index * 0.39));
  return `M${x + sway} -9 C${x + sway * 2} 40 ${x - sway} 77 ${x - sway} 115 S${x + sway} 164 ${x + sway} 205 S${x} 247 ${x} 275`;
});
---

<section class="home home--orbital">
  <MatrixWaves />
  <div class="home-content">
    <div class="home-heading">
      <p class="eyebrow">
        <span class="signal"></span> Computer engineering / Personal orbit
      </p>
      <h1>
        Patryk Opilka<span>.</span>
      </h1>
      <p class="home-description">
        Computer engineering, from the metal up.
        <br class="mobile-break" /> A place for things I build, learn, and
        explore.
      </p>
    </div>
    <div class="home-universe">
      <OrbitScene />
    </div>
  </div>
</section>
<div class="home-tail" data-home-landing-tail>
  <svg class="home-tail-art" viewBox="0 0 1280 270" preserveAspectRatio="none" focusable="false" aria-hidden="true">
    {tailTraces.map((trace) => <path d={trace} vector-effect="non-scaling-stroke" />)}
  </svg>
  <section class="home-bottom" aria-label="Around the site">
  <div class="bottom-heading">
    <span class="eyebrow">Beyond the orbit</span>
    <p>
      A workbench for ideas.
      <br />
      Always a little unfinished.
    </p>
  </div>
  <a href="/projects/" class="bottom-link">
    <span class="eyebrow">The workbench</span>
    <h2>
      Projects in progress <span class="arrow-icon" aria-hidden="true"></span>
    </h2>
    <p>Making room for work worth sharing.</p>
  </a>
  {systemsNotes.length ? (
    <section class="bottom-notes" aria-labelledby="systems-notes-title" data-systems-notes>
      <p class="eyebrow">From the journal</p>
      <h2 id="systems-notes-title">Start with the systems notes</h2>
      <ul>
        {systemsNotes.map(({ href, title, summary }) => (
          <li>
            <a class="note-link" href={href}>
              <span>
                <span class="note-title">{title}</span>
                <span class="note-summary">{summary}</span>
              </span>
              <span class="arrow-icon" aria-hidden="true"></span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ) : post ? (
    <a href={`/blog/${post.slug}/`} class="bottom-link">
      <>
        <span class="eyebrow">Latest field note</span>
        <h2>
          {post.data.title} <span class="arrow-icon" aria-hidden="true" />
        </h2>
        <p>
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString("en-US", {
              year: "numeric",
              month: "short",
              day: "numeric",
              timeZone: "UTC",
            })}
          </time>{" "}
          · Read the note
        </p>
      </>
    </a>
  ) : (
    <a href="/blog/" class="bottom-link">
      <>
        <span class="eyebrow">Field notes</span>
        <h2>
          Writing <span class="arrow-icon" aria-hidden="true" />
        </h2>
        <p>Notes, questions, and things learned.</p>
      </>
    </a>
  )}
  </section>
</div>
<style>
  .home {
    position: relative;
    isolation: isolate;
    padding-top: 54px;
  }
  .home-content,
  .home-bottom {
    width: min(calc(100% - 2 * var(--pad)), calc(var(--maxw) - 2 * var(--pad)));
    margin-inline: auto;
  }
  .home-heading {
    text-align: center;
    position: relative;
    z-index: 2;
  }
  .home-heading .eyebrow {
    margin-bottom: 19px;
  }
  .signal {
    display: inline-block;
    width: 5px;
    height: 5px;
    background: var(--accent);
    border-radius: 50%;
    margin-right: 8px;
    vertical-align: 2px;
  }
  .home h1 {
    font-size: clamp(3.2rem, 7.5vw, 6.4rem);
    font-weight: 500;
    margin-bottom: 18px;
    line-height: 0.98;
    letter-spacing: -0.065em;
  }
  .home h1 span,
  .home h1 em {
    color: var(--accent);
  }
  .home-description {
    font-size: 14px;
    color: #a5b5ae;
    line-height: 1.7;
    margin-bottom: 0;
  }
  .home-universe {
    max-width: 940px;
    margin: 8px auto 0;
  }
  .mobile-break {
    display: none;
  }
  .home-tail {
    position: relative;
    isolation: isolate;
    flex: 1 0 auto;
    margin-top: -31px;
    pointer-events: none;
    padding: 63px 0 36px;
  }
  .home-tail::before {
    content: "";
    position: absolute;
    z-index: -2;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 50% 3%, #0b362344, transparent 59%),
      linear-gradient(180deg, transparent, #07140e 43%, #06130d 100%);
    mask-image: linear-gradient(to bottom, transparent, #000 24px);
  }
  .home-tail-art {
    position: absolute;
    z-index: -1;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: #3eab65;
    stroke-width: 0.8;
    opacity: 0.42;
    mask-image: linear-gradient(180deg, transparent, #000b 19%, #0006 42%, transparent 92%);
    pointer-events: none;
  }
  .home-tail-art path:nth-child(5n) { stroke: #65c989; }
  .home-bottom {
    position: relative;
    pointer-events: auto;
    display: grid;
    grid-template-columns: 1fr 1.15fr 1.15fr;
    gap: 0;
    border-top: 1px solid #78b19154;
    border-bottom: 1px solid #78b19129;
    background: linear-gradient(115deg, #0e2118df, #09160ff0 55%, #0b1b13dc);
    box-shadow: 0 10px 30px #02080561;
  }
  .home-bottom::before {
    content: "";
    position: absolute;
    inset: -1px 0 auto;
    height: 1px;
    pointer-events: none;
    background: linear-gradient(90deg, #a2efb9b3 0, #7bd59850 13%, transparent 53%, #7bd59865);
  }
  .bottom-heading,
  .bottom-notes,
  .bottom-link {
    min-width: 0;
    padding: clamp(16px, 2.2vw, 28px);
  }
  .bottom-heading .eyebrow,
  .bottom-notes .eyebrow,
  .bottom-link .eyebrow {
    font-size: 10px;
    letter-spacing: 0.13em;
    color: #b1efcb;
  }
  .bottom-heading p {
    font-size: 14px;
    line-height: 1.5;
    color: #b4c7bb;
    margin: 9px 0 0;
  }
  .bottom-link {
    display: block;
    text-decoration: none;
    border-left: 1px solid #78b19137;
  }
  .bottom-link:hover, .bottom-link:focus-visible { background: #12291c; }
  .bottom-link:focus-visible { outline-offset: -3px; }
  .bottom-link h2 {
    font-size: 19px;
    margin: 8px 0 8px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    overflow-wrap: anywhere;
    letter-spacing: -0.02em;
  }
  .bottom-link h2 span { color: var(--accent); }
  .bottom-link p {
    font-size: 12px;
    color: #b4c7bb;
    margin: 0;
  }
  .bottom-notes {
    border-left: 1px solid #78b19137;
  }
  .bottom-notes .eyebrow { margin: 0; }
  .bottom-notes h2 {
    font-size: 19px;
    letter-spacing: -0.02em;
    margin: 8px 0 6px;
  }
  .bottom-notes ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .bottom-notes li + li { border-top: 1px solid #78b19137; }
  .note-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 8px 3px;
    min-height: 44px;
    text-decoration: none;
  }
  .note-link:hover, .note-link:focus-visible { background: #12291c; }
  .note-link:focus-visible {
    outline: 2px solid #b1efcb;
    outline-offset: -2px;
  }
  .note-link .arrow-icon { flex: none; }
  .note-title {
    display: block;
    color: #e3efe8;
    overflow-wrap: anywhere;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
  }
  .note-summary {
    display: block;
    color: #b4c7bb;
    font-size: 12px;
    line-height: 1.4;
    margin-top: 3px;
  }
  @media (max-width: 650px) {
    .home {
      padding-top: 36px;
    }
    .home-heading .eyebrow {
      font-size: 8px;
      letter-spacing: 0.09em;
    }
    .home h1 {
      font-size: clamp(2.7rem, 10vw, 4rem);
    }
    .home-description {
      font-size: 12px;
    }
    .mobile-break {
      display: block;
    }
    .home-universe {
      margin-top: 4px;
    }
    .home-tail { margin-top: -22px; padding: 43px 0 26px; }
    .home-tail-art { opacity: 0.28; }
    .home-bottom { grid-template-columns: minmax(0, 1fr); }
    .bottom-heading {
      display: none;
    }
    .bottom-link { border-left: 0; }
    .bottom-notes { border-left: 0; border-top: 1px solid #78b19137; }
    .bottom-link + .bottom-link { border-top: 1px solid #78b19137; }
    .bottom-link h2 {
      font-size: 20px;
    }
  }
</style>
