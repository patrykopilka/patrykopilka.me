  .virtio-byte-drill ol { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); gap: .6rem; padding: 0; margin-block: 1rem; }
  .virtio-byte-drill li { border: 1px solid currentColor; margin: 0; padding: .65rem; min-inline-size: 0; }
  .virtio-byte-drill .bytes { display: inline-block; border: 1px solid currentColor; padding: .2rem .45rem; font-size: 1rem; }
  .virtio-byte-drill summary { cursor: pointer; padding-block: .65rem; text-decoration: underline; text-underline-offset: .18em; }
