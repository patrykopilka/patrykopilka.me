---
import "../styles/global.scss";
import GreenConsoleHeader from "../components/GreenConsoleHeader.astro";
const {
  title = "Patryk Opilka",
  description = "Computer engineering, systems, and experiments.",
  fullBleed = false,
  greenConsoleHeader = false,
  homeLanding = false,
  notFound = false,
} = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const links = [
  { url: "/blog/", label: "Writing" },
  { url: "/projects/", label: "Projects" },
  { url: "/resume/", label: "Résumé" },
  { url: "/about/", label: "About" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {notFound ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
  </head>
  <body class:list={{ "home-landing": homeLanding }}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    {greenConsoleHeader ? <GreenConsoleHeader links={links} path={path} /> : (
      <header class="site-header">
        <a href="/" class="brand" aria-label="Patryk Opilka, home">
          <span class="brand-mark" aria-hidden="true">
            ◇
          </span>{" "}
          patryk<span class="brand-light">opilka</span>
          <span class="brand-dot">.</span>
        </a>
        <nav class="site-nav" aria-label="Main navigation">
          {links.map((link) => (
            <a
              href={link.url}
              aria-current={path === link.url || `${path}/` === link.url ? "page" : undefined}
            >
              {link.label}
            </a>
          ))}
        </nav>
      </header>
    )}
    <main id="main" class:list={["container", { "container--full-bleed": fullBleed }]}>
      <slot />
    </main>
    <footer class:list={["site-footer", { "site-footer--home": homeLanding }]}>
      <p>© {new Date().getFullYear()} Patryk Opilka</p>
      <p>Made with curiosity. Built with Astro.</p>
      <a href="https://github.com/po63njit">
        GitHub <span class="arrow-icon" aria-hidden="true"></span>
      </a>
    </footer>
  </body>
</html>
